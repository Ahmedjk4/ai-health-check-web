# Copy to .env. Never put your API key in public/ or commit .env.
HOST=127.0.0.1
PORT=3000
HACKCLUB_API_KEY=
HACKCLUB_MODEL=openai/gpt-4.1-mini
# Required when an API key is configured. Enter this code in the app's AI connection dialog.
# Use a long random value (at least 16 characters).
CHAT_ACCESS_TOKEN=
